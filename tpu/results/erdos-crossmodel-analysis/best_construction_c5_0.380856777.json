.9999999999407402, 0.9999999999407402, 0.9999999999407402, 0.9999999999407402, 0.9999999999407402, 0.9999999999407402, 0.9999999999407402, 0.9999999999407402, 0.9999999999407402, 0.9999999999407402, 0.9999999999407402, 0.9999999999407402, 0.9999999999407402, 0.9999999999407402, 0.9999999999407402, 0.9999999999407402, 0.9999999999407402, 0.9999999999407402, 0.9999999999407402, 0.9999999999407402, 0.9999999999407402, 0.9999999999407402, 0.9999999999407402, 0.9999999999407402, 0.9999999999977727, 0.9999999999407402, 0.9999999999407402, 0.9999999999407402, 0.9999999999407402, 0.9999999999407402, 0.9999999999407402, 0.9999999999407402, 0.9999999999407402, 0.9999999999407402, 0.9999999999407402, 0.9999999999407402, 0.9999999999407402, 0.9999999999407402, 0.9999999999407402, 0.9999999999407402, 0.9999999999999919, 0.9999999999407402, 0.9999999999407402, 0.9999999999407402, 0.9999999999407402, 0.9999999999407402, 0.9999999999407402, 0.9999999999407402, 0.9999999999407402, 0.9999999999407402, 0.9999999999407402], "code": "```python\nimport numpy as np\nimport time\nfrom scipy.optimize import minimize\n\ndef stable_smooth_max(values, beta):\n    c_max = np.max(values)\n    if beta < 1e-12:\n        return float(c_max)\n    shifted = values - c_max\n    max_shift = np.max(shifted)\n    exp_vals = np.exp(np.clip(beta * (shifted - max_shift), -500, 500))\n    return float(c_max + (max_shift + np.log(np.sum(exp_vals))) / beta)\n\n\ndef compute_raw_overlap(h):\n    corrs = np.correlate(h, 1.0 - h, mode='full')\n    return float(np.max(corrs))\n\n\ndef project_sum(h, target_sum):\n    s = np.sum(h)\n    if s == 0:\n        return h\n    h = h * (target_sum / s)\n    for _ in range(12):\n        over = h > 1.0\n        under = h < 0.0\n        if not np.any(over | under):\n            break\n        h = np.clip(h, 0.0, 1.0)\n        s = np.sum(h)\n        if s == 0:\n            break\n        h = h * (target_sum / s)\n    return h\n\n\ndef refine_h_coarse(h, target_sum, max_iter=2500, rng=None):\n    if rng is None:\n        rng = np.random.default_rng(1)\n    n = h.shape[0]\n    cur = h.copy()\n    best_h = cur.copy()\n    best_val = compute_raw_overlap(best_h)\n    step_sizes = [2e-3, 1e-3, 5e-4, 2e-4, 1e-4, 5e-5]\n    for it in range(max_iter):\n        i = rng.integers(0, n)\n        improved = False\n        for ds in step_sizes:\n            for sign in (-1, 1):\n                cand = cur.copy()\n                cand[i] += sign * ds\n                cand = np.clip(cand, 0.0, 1.0)\n                cand = project_sum(cand, target_sum)\n                val = compute_raw_overlap(cand)\n                if val < best_val - 1e-14:\n                    best_val = val\n                    best_h = cand.copy()\n                    cur = cand.copy()\n                    improved = True\n                    break\n            if improved:\n                break\n        if not improved and it % 25 == 0:\n            noise = rng.normal(0, 3e-4, n)\n            cand = cur + noise\n            cand = np.clip(cand, 0.0, 1.0)\n            cand = project_sum(cand, target_sum)\n            val = compute_raw_overlap(cand)\n            if val < best_val - 1e-14:\n                best_val = val\n                best_h = cand.copy()\n                cur = cand.copy()\n    return best_h, best_val\n\n\ndef build_initial_profile(n):\n    x = np.linspace(0, 2, n, endpoint=False)\n    centre = 1.0\n    width = 0.9\n    edge = 0.03\n    h = 0.5 * (1 - np.tanh((np.abs(x - centre) - width/2) / edge))\n    h = h / np.mean(h) * 0.5\n    h = np.clip(h, 0.0, 1.0)\n    return h\n\n\ndef run(seed=42, budget_s=1000, **kwargs):\n    np.random.seed(seed)\n    rng = np.random.default_rng(seed)\n    start_time = time.time()\n\n    n = 801\n    dx = 2.0 / n\n    target_sum = n / 2.0\n\n    try:\n        init = np.asarray(initial_h_values, dtype=float)\n        if init.shape[0] == n:\n            h0 = init.copy()\n        else:\n            h0 = np.interp(np.linspace(0, 1, n), np.linspace(0, 1, init.shape[0]), init)\n    except Exception:\n        h0 = build_initial_profile(n)\n\n    h0 = np.clip(h0, 0.0, 1.0)\n    h0 = project_sum(h0, target_sum)\n\n    best_h = h0.copy()\n    best_val = compute_raw_overlap(best_h) * dx\n\n    bounds = [(0.0, 1.0) for _ in range(n)]\n    cons = [{'type': 'eq', 'fun': lambda x, ts=target_sum: np.sum(x) - ts}]\n\n    def obj_smooth(x, beta=2000.0):\n        corrs = np.correlate(x, 1.0 - x, mode='full')\n        return stable_smooth_max(corrs, beta)\n\n    beta_schedule = [400.0, 1600.0, 6400.0, 25600.0, 102400.0]\n    noises = [0.0, 2e-3, 6e-3, 1.2e-2, 2.5e-2]\n\n    for noise_std in noises:\n        if time.time() - start_time > budget_s * 0.55:\n            break\n        h_curr = best_h.copy()\n        if noise_std > 0:\n            h_curr = h_curr + rng.normal(0, noise_std, n)\n            h_curr = np.clip(h_curr, 0.0, 1.0)\n            h_curr = project_sum(h_curr, target_sum)\n\n        for beta in beta_schedule:\n            if time.time() - start_time > budget_s * 0.80:\n                break\n            opts = {'maxiter': 300, 'ftol': 1e-13, 'disp': False}\n            try:\n                res = minimize(lambda x: obj_smooth(x, beta),\n                               h_curr, method='SLSQP',\n                               bounds=bounds, constraints=cons,\n                               options=opts)\n                h_curr = res.x\n                h_curr = np.clip(h_curr, 0.0, 1.0)\n                h_curr = project_sum(h_curr, target_sum)\n            except Exception:\n                pass\n\n        h_ref, raw = refine_h_coarse(h_curr, target_sum, max_iter=2000, rng=rng)\n        val = compute_raw_overlap(h_ref) * dx\n        if val < best_val:\n            best_val = val\n            best_h = h_ref.copy()\n\n    h_curr = best_h.copy()\n    for beta in [200000.0, 400000.0]:\n        if time.time() - start_time > budget_s * 0.98:\n            break\n        opts = {'maxiter': 200, 'ftol': 1e-14, 'disp': False}\n        try:\n            res = minimize(lambda x: obj_smooth(x, beta),\n                           h_curr, method='SLSQP',\n                           bounds=bounds, constraints=cons,\n                           options=opts)\n            h_curr = res.x\n            h_curr = np.clip(h_curr, 0.0, 1.0)\n            h_curr = project_sum(h_curr, target_sum)\n        except Exception:\n            pass\n\n    best_h = project_sum(h_curr, target_sum)\n    c5_bound = float(compute_raw_overlap(best_h) * dx)\n    return best_h.astype(float), c5_bound, int(n)\n```"}