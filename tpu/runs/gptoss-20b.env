# gpt-oss-20b (full LoRA: attention + BF16 router + separate expert factors)
# math-RL on a v5p-16 spot slice.
# Launch: ./tpu/autoresume_run.sh tpu/runs/gptoss-20b.env
#
# TODO-manual bring-up (BRINGUP_MANUAL=1): the colocated launcher does NOT
# yet automate the gpt-oss server side. After the node is READY the
# supervisor waits for a manually started Tinker API on worker 0. Manual
# steps (details in the tunix-tinker-backend memory file,
# ~/.claude/projects/-scratch-gpfs-ZHUANGL-sk7524-tunix/memory/tunix-tinker-backend.md):
#   1. vLLM (worker 1) serves the native openai/gpt-oss-20b MXFP4 checkpoint
#      with --enable-lora --max-lora-rank 32. The patched GMM path keeps MXFP4
#      expert weights immutable and applies BF16 factors separately; do not use
#      the old dequantized BF16 model copy.
#   2. Tinker API (worker 0) via ~/start_gptoss_skyrl_api.sh — full-LoRA
#      variant. NOTE: that script was edited IN PLACE for the attn-only
#      ablation; restore from ~/start_gptoss_skyrl_api.sh.bak-fullrun before
#      a full-LoRA run. backend_config carries
#      model_path=.../gcs/skyrl-maxtext-ckpts/gpt-oss-20b/0/items.
BRINGUP_MANUAL=1

# --- identity / infra -------------------------------------------------------
RUN_NAME=gptoss-20b
TPU_NAME=sk7524-tunix-mathrl-v5p16-r12-east5a_spot
# jobman yaml names omit the _spot suffix; jobman appends it from pricing.
# gpt-oss runs use the shared r12 machine / skyrl_tunix yaml.
JOBMAN_YAML=tpu/runs/yamls/skyrl_tunix_v5p16_spot.yaml

# --- server (reference values; consumed by the manual bring-up) --------------
TINKER_BACKEND=tunix
TRAIN_WORKERS=0
VLLM_WORKERS=1
MODEL_NAME=openai/gpt-oss-20b
TUNIX_MAXTEXT_MODEL_NAME=gpt-oss-20b
# Native sparse expert-LoRA support; pin the tested fork commit so `uv sync`
# cannot silently replace it with stock MaxText.
TUNIX_MAXTEXT_PIP_SPEC="maxtext @ git+https://github.com/SachinKonan/maxtext.git@d388c5478b18b2322ab36c032deb87b9a4ff065f"
TRAIN_MICRO_BATCH_SIZE=8

# --- client (run_tinker_math_rl_qwen35_9b.sh) --------------------------------
# No RENDERER_NAME: the cookbook auto-picks the harmony renderer for gpt-oss.
ROLLOUT_ERROR_TOLERANCE=1
STREAM_NUM_MINIBATCHES=8
GROUP_SIZE=8
GROUPS_PER_BATCH=32
MAX_TOKENS=512
LORA_RANK=32
# Reference run: eval peaked 76.8% at step 60 then overfit at constant
# lr 2e-5 — consider early stop ~60-80 or lr decay next time.
MAX_STEPS=180
SAVE_EVERY=20
EVAL_EVERY=20
LEARNING_RATE=2e-5
CLIENT_SESSION=skyrl-math-rl-gptoss
LOCAL_PORT=18000
LOG_PATH=/home/sk7524/skyrl-runs/math_rl/math-gptoss-20b-fullrun-v2

# NOTE: shares TPU_NAME and ports with gptoss-20b-attnonly.env — never run
# both supervisors at once.
