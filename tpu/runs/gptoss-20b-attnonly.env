# gpt-oss-20b ATTENTION-ONLY LoRA ablation (lora_mlp_regex="(?!)": no MoE
# expert/router LoRA, no merge-on-load sidecar, 63.7MB adapters vs 845MB).
# Launch: ./tpu/autoresume_run.sh tpu/runs/gptoss-20b-attnonly.env
#
# TODO-manual bring-up (BRINGUP_MANUAL=1): the colocated launcher does NOT
# yet automate the gpt-oss server side. After the node is READY the
# supervisor waits for a manually started Tinker API on worker 0. Manual
# steps (details in the tunix-tinker-backend memory file,
# ~/.claude/projects/-scratch-gpfs-ZHUANGL-sk7524-tunix/memory/tunix-tinker-backend.md):
#   1. vLLM (worker 1): bf16 LOCAL-disk copy
#      (/home/sk7524_princeton_edu/gpt-oss-20b-bf16-local, quantization_config
#      stripped), --served-model-name openai/gpt-oss-20b, --enable-lora
#      --max-lora-rank 32. Attn-only adapters go through vLLM's STANDARD
#      load_lora_adapter path (no "MoE LoRA merge" log lines expected).
#   2. Tinker API (worker 0) via ~/start_gptoss_skyrl_api.sh WITH
#      lora_mlp_regex="(?!)" added to the backend_config (the attn-only
#      edit; the pristine full-LoRA copy is
#      ~/start_gptoss_skyrl_api.sh.bak-fullrun).
BRINGUP_MANUAL=1

# --- identity / infra -------------------------------------------------------
RUN_NAME=gptoss-20b-attnonly
TPU_NAME=sk7524-tunix-mathrl-v5p16-r12-east5a_spot
# jobman yaml names omit the _spot suffix; jobman appends it from pricing.
# gpt-oss runs use the shared r12 machine / skyrl_tunix yaml.
JOBMAN_YAML=tpu/runs/yamls/skyrl_tunix_v5p16_spot.yaml

# --- server (reference values; consumed by the manual bring-up) --------------
TINKER_BACKEND=tunix
TRAIN_WORKERS=0
VLLM_WORKERS=1
MODEL_NAME=openai/gpt-oss-20b
TUNIX_MAXTEXT_MODEL_NAME=gpt-oss-20b
TRAIN_MICRO_BATCH_SIZE=8

# --- client (run_tinker_math_rl_qwen35_9b.sh) --------------------------------
# No RENDERER_NAME: the cookbook auto-picks the harmony renderer for gpt-oss.
ROLLOUT_ERROR_TOLERANCE=1
STREAM_NUM_MINIBATCHES=8
GROUP_SIZE=8
GROUPS_PER_BATCH=32
MAX_TOKENS=512
LORA_RANK=32
MAX_STEPS=80
SAVE_EVERY=20
EVAL_EVERY=20
LEARNING_RATE=2e-5
CLIENT_SESSION=skyrl-math-rl-gptoss-attnonly
LOCAL_PORT=18010
# Client uv cache MUST live on /home (the /scratch group fileset filling up
# killed two earlier runs). Set here because the supervisor runs inside tmux,
# whose server env carries the login default UV_CACHE_DIR=/scratch/...
UV_CACHE_DIR=/home/sk7524/.cache/uv-skyrl
CLIENT_UV_CACHE_DIR=/home/sk7524/.cache/uv-skyrl
LOG_PATH=/home/sk7524/skyrl-runs/math_rl/math-gptoss-20b-attnonly-2026-07-21-03-30

# NOTE: shares TPU_NAME with gptoss-20b.env — never run both supervisors at
# once.
