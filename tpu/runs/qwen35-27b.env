# Qwen3.5-27B dense math-RL on a v5p-16 spot slice (trainer worker 0, vLLM
# worker 1). Launch: ./tpu/autoresume_run.sh tpu/runs/qwen35-27b.env
#
# Model support comes from our MaxText fork (SachinKonan/maxtext@skyrl/
# qwen35-dense): dense-MLP qwen3_5 decoder, qwen3.5-27b.yml, converter
# mapping, zero-centered final norm, mRoPE disabled for text-only.

# --- identity / infra -------------------------------------------------------
RUN_NAME=qwen35-27b
TPU_NAME=sk7524-tunix-qwen35-v5p16-r1-east5a_spot
# jobman yaml names omit the _spot suffix; jobman appends it from pricing.
JOBMAN_YAML=tpu/runs/yamls/skyrl_qwen35_v5p16_spot.yaml

# --- server bring-up (start_colocated_vllm_tinker.sh) ------------------------
TINKER_BACKEND=tunix
TRAIN_WORKERS=0
VLLM_WORKERS=1
MODEL_NAME=Qwen/Qwen3.5-27B
TUNIX_MAXTEXT_MODEL_NAME=qwen3.5-27b
# The api script's exact `uv sync` wipes manual installs and reinstalls stock
# pypi maxtext; passing the fork spec here keeps bring-up single-shot.
TUNIX_MAXTEXT_PIP_SPEC="maxtext @ git+https://github.com/SachinKonan/maxtext.git@skyrl/qwen35-dense"
TRAIN_MICRO_BATCH_SIZE=8
# Multimodal-arch models on TPU need a power-of-2 batched-tokens pin, or the
# LoRA punica buffers mismatch the warmup buckets (RuntimeError).
VLLM_EXTRA_ARGS="--max-num-batched-tokens 4096"

# --- client (run_tinker_math_rl_qwen35_9b.sh) --------------------------------
# The default qwen3_5 thinking renderer burns the whole 512-token budget
# inside <think> (0.8% format); the disable-thinking renderer is REQUIRED.
RENDERER_NAME=qwen3_5_disable_thinking
ROLLOUT_ERROR_TOLERANCE=1
STREAM_NUM_MINIBATCHES=8
GROUP_SIZE=8
GROUPS_PER_BATCH=32
MAX_TOKENS=512
LORA_RANK=32
MAX_STEPS=180
SAVE_EVERY=20
EVAL_EVERY=20
LEARNING_RATE=2e-5
CLIENT_SESSION=skyrl-math-rl-qwen35
LOCAL_PORT=18035
LOG_PATH=/home/sk7524/skyrl-runs/math_rl/math-qwen35-27b-fullrun-2026-07-20
