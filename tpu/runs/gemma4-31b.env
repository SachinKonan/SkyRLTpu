# Gemma4-31B math-RL on a v5p-16 spot slice (trainer worker 0, vLLM
# worker 1). Launch: ./tpu/autoresume_run.sh tpu/runs/gemma4-31b.env
#
# Dense model on stock MaxText (gemma4-31b.yml ships upstream); standard
# HF-PEFT adapter path, no merge-on-load machinery.

# --- identity / infra -------------------------------------------------------
RUN_NAME=gemma4-31b
TPU_NAME=sk7524-tunix-gemma4-v5p16-r1-east5a_spot
# jobman yaml names omit the _spot suffix; jobman appends it from pricing.
JOBMAN_YAML=tpu/runs/yamls/skyrl_gemma4_v5p16_spot.yaml

# --- server bring-up (start_colocated_vllm_tinker.sh) ------------------------
TINKER_BACKEND=tunix
TRAIN_WORKERS=0
VLLM_WORKERS=1
MODEL_NAME=google/gemma-4-31B-it
TUNIX_MAXTEXT_MODEL_NAME=gemma4-31b
TRAIN_MICRO_BATCH_SIZE=8
# Gemma4 is multimodal: vllm otherwise derives max_num_batched_tokens=2496
# (non-power-of-2) and the LoRA punica index buffer mismatches the
# power-of-2 warmup buckets (RuntimeError). Always pin 4096.
VLLM_EXTRA_ARGS="--max-num-batched-tokens 4096"

# --- client (run_tinker_math_rl_qwen35_9b.sh) --------------------------------
RENDERER_NAME=gemma4
ROLLOUT_ERROR_TOLERANCE=1
STREAM_NUM_MINIBATCHES=8
GROUP_SIZE=8
GROUPS_PER_BATCH=32
MAX_TOKENS=512
LORA_RANK=32
MAX_STEPS=180
SAVE_EVERY=20
EVAL_EVERY=20
LEARNING_RATE=2e-5
CLIENT_SESSION=skyrl-math-rl-gemma4
LOCAL_PORT=18001
LOG_PATH=/home/sk7524/skyrl-runs/math_rl/math-gemma4-31b-fullrun-2026-07-21-01-56
